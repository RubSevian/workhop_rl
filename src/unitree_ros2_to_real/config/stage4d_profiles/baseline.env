# Stable integration baseline. Source before scripts/stage4d_start.sh.
# The launch consumes these environment variables directly; do not edit C++.
export STAGE4D_SEARCH_RADIUS=0.55
export STAGE4D_VEHICLE_LENGTH=0.62
export STAGE4D_VEHICLE_WIDTH=0.40
export STAGE4D_GOAL_CLEAR_RANGE=0.50
export STAGE4D_GOAL_CLOSE_DIS=0.40
export STAGE4D_FAR_CONVERGE_DISTANCE=0.25
export STAGE4D_STOP_DIS_THRE=0.30
export STAGE4D_SLOW_DOWN_DIS_THRE=0.75
export STAGE4D_ENABLE_ORIENTATION_AWARE_CHECK=false
export STAGE4D_ENABLE_NARROW_RECOVERED_SELECTION=false
