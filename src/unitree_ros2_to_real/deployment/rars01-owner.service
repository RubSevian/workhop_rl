[Unit]
Description=Persistent RARS01 AUTO HOME serial owner
After=local-fs.target

[Service]
Type=simple
User=ruben
Group=ruben
SupplementaryGroups=dialout
EnvironmentFile=/etc/rars01-owner.env
StateDirectory=rars01-owner
StateDirectoryMode=0700
RuntimeDirectory=rars01-owner
RuntimeDirectoryMode=0700
ExecStart=/home/ruben/go2_diploma/sim2real/install_r1/unitree_legged_real/share/unitree_legged_real/deployment/run_rars01_owner.sh
# Fault stops the running session. New enable requires a new owner start.
# Diagnostic journal does not block restart; no automatic process restart.
Restart=no
KillSignal=SIGINT
TimeoutStopSec=10
UMask=0077

[Install]
WantedBy=multi-user.target
